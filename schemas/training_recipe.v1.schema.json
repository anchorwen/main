{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://future/schemas/training_recipe.v1.schema.json",
  "title": "Training Recipe",
  "description": "The single source of truth for one reproducible training run. A Recipe combines model identity, label contract reference, data configuration, training hyperparameters, and evaluation criteria. Two recipes that differ only by seed produce the same model family.",
  "type": "object",
  "required": ["schema_version", "recipe_id", "model_identity", "label_contract_ref", "data", "training", "evaluation"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "training_recipe.v1"
    },
    "recipe_id": {
      "type": "string",
      "description": "Unique identifier, e.g. CRT.sur.chlg.g2026.1"
    },
    "model_identity": {
      "type": "object",
      "required": ["lane", "role", "generation", "feature_contract_id"],
      "properties": {
        "lane": {
          "type": "string",
          "enum": ["sur", "mtx", "arb", "xgbinrepo"],
          "description": "Strategy lane: sur=survival-barrier, mtx=matrix-transformer, arb=arbitrage"
        },
        "role": {
          "type": "string",
          "enum": ["prd", "chlg", "cabl", "stub"],
          "description": "Brain role: prd=production, chlg=challenger, cabl=candidate-baseline, stub=placeholder"
        },
        "generation": {
          "type": "string",
          "description": "Model generation identifier, e.g. g2026.1"
        },
        "feature_contract_id": {
          "type": "string",
          "description": "Reference to the feature contract used, e.g. feat-v9-institutional-1.0.0"
        }
      }
    },
    "label_contract_ref": {
      "type": "object",
      "required": ["contract_id"],
      "properties": {
        "contract_id": {
          "type": "string",
          "description": "Reference to the label contract, e.g. label-survival-barrier-1.0.0"
        },
        "contract_path": {
          "type": "string",
          "description": "Optional relative path to the contract JSON file"
        }
      }
    },
    "data": {
      "type": "object",
      "required": ["dataset_slice_id"],
      "properties": {
        "dataset_slice_id": {
          "type": "string",
          "description": "Identifier for the dataset slice used"
        },
        "train_date_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "format": "date" },
          "description": "[start_date, end_date] for training data"
        },
        "val_date_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "format": "date" },
          "description": "[start_date, end_date] for validation data"
        },
        "min_samples_per_class": {
          "type": "integer",
          "minimum": 10,
          "default": 100
        },
        "normalization_strategy": {
          "type": "string",
          "enum": ["fixed", "rolling_ewma", "rank"],
          "default": "fixed"
        },
        "normalization_halflife_days": {
          "type": "integer",
          "minimum": 1,
          "default": 63
        },
        "data_augmentation": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "volatility_scaling": {
              "type": "array",
              "items": { "type": "number" },
              "default": [0.7, 0.85, 1.0, 1.15, 1.3]
            },
            "noise_std": {
              "type": "number",
              "minimum": 0,
              "default": 0.01
            }
          }
        }
      }
    },
    "training": {
      "type": "object",
      "required": ["epochs", "architecture"],
      "properties": {
        "epochs": { "type": "integer", "minimum": 1, "default": 200 },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" },
          "default": [42]
        },
        "architecture": {
          "type": "string",
          "enum": ["mlp_multihead", "transformer", "xgboost", "ou_params", "online_sgd"]
        },
        "input_dim": { "type": "integer", "minimum": 1, "default": 40 },
        "hidden_dims": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "default": [128, 64, 32]
        },
        "dropout": { "type": "number", "minimum": 0, "maximum": 0.9, "default": 0.3 },
        "loss_weights": {
          "type": "object",
          "default": { "direction": 1.0, "risk": 0.5, "volatility": 0.3 }
        },
        "optimizer": {
          "type": "string",
          "enum": ["adam", "adamw", "sgd"],
          "default": "adam"
        },
        "learning_rate": { "type": "number", "exclusiveMinimum": 0, "default": 0.001 },
        "batch_size": { "type": "integer", "minimum": 8, "default": 256 },
        "early_stopping_patience": { "type": "integer", "minimum": 1, "default": 20 }
      }
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "accuracy", "precision", "recall", "f1",
              "sharpe_ratio", "sortino_ratio", "max_drawdown",
              "profit_factor", "win_rate", "avg_pnl",
              "direction_bias", "regime_consistency"
            ]
          },
          "default": ["accuracy", "f1", "sharpe_ratio"]
        },
        "regime_splits": {
          "type": "object",
          "description": "Per-regime evaluation thresholds, e.g. {\"low\": {\"atr_range\": [0, 1.5]}}"
        },
        "stability_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["walk_forward", "seed_sensitivity", "regime_consistency", "data_augmentation_robustness"]
          },
          "default": ["walk_forward", "seed_sensitivity"]
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata (description, author, changelog, etc.)"
    }
  }
}
