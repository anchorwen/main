{
  "schema_version": "training_recipe.v1",
  "recipe_id": "CRT.sur.chlg.g2026.1",
  "model_identity": {
    "lane": "sur",
    "role": "chlg",
    "generation": "g2026.1",
    "feature_contract_id": "feat-v9-institutional-1.0.0"
  },
  "label_contract_ref": {
    "contract_id": "label-survival-barrier-1.0.0",
    "contract_path": "configs/training/label_contracts/label-survival-barrier-1.0.0.json"
  },
  "data": {
    "dataset_slice_id": "xauusd-m5-2025",
    "train_date_range": ["2025-01-01", "2025-12-31"],
    "val_date_range": ["2026-01-01", "2026-04-30"],
    "min_samples_per_class": 100,
    "normalization_strategy": "fixed",
    "normalization_halflife_days": 63,
    "data_augmentation": {
      "enabled": true,
      "volatility_scaling": [0.7, 0.85, 1.0, 1.15, 1.3],
      "noise_std": 0.01
    }
  },
  "training": {
    "epochs": 200,
    "seeds": [42, 43, 44, 45, 46],
    "architecture": "mlp_multihead",
    "input_dim": 40,
    "hidden_dims": [128, 64, 32],
    "dropout": 0.3,
    "loss_weights": {
      "direction": 1.0,
      "risk": 0.5,
      "volatility": 0.3
    },
    "optimizer": "adam",
    "learning_rate": 0.001,
    "batch_size": 256,
    "early_stopping_patience": 20
  },
  "evaluation": {
    "metrics": ["accuracy", "f1", "sharpe_ratio", "profit_factor", "win_rate", "max_drawdown"],
    "regime_splits": {
      "low": { "atr_percentile": [0, 33] },
      "normal": { "atr_percentile": [33, 67] },
      "high": { "atr_percentile": [67, 100] }
    },
    "stability_checks": ["walk_forward", "seed_sensitivity", "regime_consistency"]
  },
  "metadata": {
    "description": "First formal training recipe for sur lane (survival barrier). Uses V9 Institutional 40-dim features with MLP multi-head architecture. Incorporates data augmentation via volatility scaling for distributional robustness. 5-seed ensemble for stability assessment.",
    "author": "quant-os",
    "created": "2026-05-05",
    "version": "1.0.0",
    "label_contract_note": "Base SL=2.0xATR / TP=3.5xATR. Live trading adjusts per-regime via RegimeDetector using calibrated multipliers: low(SL=2.00,TP=3.33), normal(SL=1.60,TP=2.98), high(SL=1.10,TP=2.10).",
    "references": [
      "docs/TRAINING_BLUEPRINT.md",
      "core/contracts/training/training_recipe.py",
      "core/contracts/training/label_contract.py"
    ]
  }
}
