{
  "$schema": "training_pipeline_contract.v1",
  "contract_id": "xau_metafilter_v1",
  "description": "XAU MetaFilter training pipeline contract — SSOT for PIT-aligned ML signal quality gate. Features match live build_meta_filter_array() output exactly: 40 V9 institutional features. Label: PnL > 0 (friction-damped binary).",

  "model_target": {
    "name": "meta_filter_v4",
    "path": "data/models/meta_filter_v4",
    "framework": "lightgbm",
    "input_dimension": 40,
    "feature_names_ssot": [
      "M5_Ret_1", "M5_Body_Ratio", "M5_ATR_14", "M5_RSI_14", "M5_MACD",
      "M5_Vol_ZScore", "M5_Macro1_Corr", "M5_Price_ZScore",
      "M15_Ret_1", "M15_Body_Ratio", "M15_ATR_14", "M15_RSI_14", "M15_MACD",
      "M15_Vol_ZScore", "M15_Macro1_Corr", "M15_Price_ZScore",
      "M30_Ret_1", "M30_Body_Ratio", "M30_ATR_14", "M30_RSI_14", "M30_MACD",
      "M30_Vol_ZScore", "M30_Macro1_Corr", "M30_Price_ZScore",
      "H1_Ret_1", "H1_Body_Ratio", "H1_ATR_14", "H1_RSI_14", "H1_MACD",
      "H1_Vol_ZScore", "H1_Macro1_Corr", "H1_Price_ZScore",
      "M5_OU_Theta", "M15_OU_Theta", "M30_OU_Theta", "H1_OU_Theta",
      "M5_Hurst", "M15_Hurst", "M30_Hurst", "H1_Hurst"
    ],
    "min_training_samples": 500,
    "min_positive_label_pct": 0.15
  },

  "stages": {
    "stage_1_feature_store": {
      "description": "Feature Store must contain v9_institutional_40 records at M5 timeframe for XAUUSDc.",
      "inputs": {},
      "outputs": {
        "v9_institutional_40": {
          "schema_name": "v9_institutional_40",
          "dimension": 40,
          "max_age_minutes": 30,
          "max_nan_pct": 0.05,
          "min_records": 1000
        }
      },
      "validation": {
        "check_schema_presence": true,
        "check_dimension_match": true,
        "check_freshness": true,
        "check_nan_rate": true
      }
    },

    "stage_2_journal": {
      "description": "Journal must contain accepted close entries with PnL for XAUUSDc.",
      "inputs": {},
      "outputs": {
        "closed_trades": {
          "min_count": 200,
          "required_fields": ["position_ticket", "pnl", "recorded_at", "side"],
          "max_pnl_null_pct": 0.05
        },
        "open_entries": {
          "required_fields": ["position_ticket", "message_id", "recorded_at", "entry_price"]
        }
      },
      "validation": {
        "check_closed_count": true,
        "check_pnl_completeness": true,
        "check_open_close_linkage": true
      }
    },

    "stage_3_dataset_builder": {
      "description": "PIT ASOF join pairs each XAUUSDc trade with the last V9 feature record before entry time. Label: PnL > 0. Builder: scripts/build_btc_metafilter_v2_dataset.py --data-dir data --symbol XAUUSDc --spread-cost-usd 0.0. FIX-20260821-006 (TECH_DEBT-020): builder_args 结构化补齐 — 此前缺字段导致 builder 默认 symbol=BTCUSDc 在 data/ 空转, 静默早退 rc=0, validator np.load 空文件抛 EOFError.",
      "inputs": {
        "from_stage_1": ["v9_institutional_40"],
        "from_stage_2": ["closed_trades", "open_entries"]
      },
      "outputs": {
        "dataset": {
          "format": "npz",
          "dimension": 40,
          "feature_order": "model_target.feature_names_ssot",
          "min_matched_samples": 500,
          "min_asof_join_rate": 0.80
        }
      },
      "builder_script": "scripts/build_btc_metafilter_v2_dataset.py",
      "builder_output_arg": "--output",
      "builder_args": ["--data-dir", "data", "--symbol", "XAUUSDc", "--spread-cost-usd", "0.0"],
      "validation": {
        "check_dimension_exact": true,
        "check_asof_join_rate": true,
        "check_no_future_leak": true,
        "check_label_distribution": true
      }
    },

    "stage_4_training": {
      "description": "LightGBM with strong regularization (max_depth=3, num_leaves=7) and TimeSeriesSplit CV. Label imbalance handled via scale_pos_weight.",
      "inputs": {
        "from_stage_3": ["dataset"]
      },
      "outputs": {
        "model": {
          "format": "sklearn_lgbmclassifier.pkl",
          "input_dimension": 40,
          "min_cv_folds": 3,
          "min_cv_auc": 0.52,
          "max_overfitting_gap": 0.40
        }
      },
      "validation": {
        "check_dimension_consistency": true,
        "check_overfitting_gap": true,
        "check_min_performance": true
      }
    }
  },

  "sla": {
    "daily_readiness_check_utc": "04:00",
    "alert_on_contract_violation": true,
    "alert_channels": ["log"],
    "stale_after_hours": 25
  },

  "metadata": {
    "author": "quant-os",
    "created_at": "2026-06-28",
    "rationale": "V1 model (715 samples, AUC=0.64) trained on derived features (oof_pred, session_sin, atr_percentile_100, etc.) that build_meta_filter_array() cannot produce. V2 trains on exactly V9_INSTITUTIONAL_40_FEATURES — live pipeline parity guaranteed.",
    "fix_id": "FIX-20260628-166",
    "supersedes": "ad-hoc meta_filter_v3 training (pre-June 2026)"
  }
}
