{
  "$schema": "training_pipeline_contract.v1",
  "contract_id": "btc_metafilter_v3",
  "description": "BTC MetaFilter V3 training pipeline contract — SSOT for all pipeline stages. Every stage producer MUST satisfy its output contract; every stage consumer MUST validate its input contract. Drift from this contract = pipeline halted + alert fired.",

  "model_target": {
    "name": "meta_filter_v3",
    "path": "data/models/meta_filter_v3",
    "framework": "lightgbm",
    "input_dimension": 47,
    "feature_names_ssot": [
      "H1_ATR_14", "H1_Body_Ratio", "H1_Hurst", "H1_MACD", "H1_Macro1_Corr",
      "H1_Price_ZScore", "H1_OU_Theta", "H1_RSI_14", "H1_Ret_1", "H1_Vol_ZScore",
      "M15_ATR_14", "M15_Body_Ratio", "M15_Hurst", "M15_MACD", "M15_Macro1_Corr",
      "M15_Price_ZScore", "M15_OU_Theta", "M15_RSI_14", "M15_Ret_1", "M15_Vol_ZScore",
      "M30_ATR_14", "M30_Body_Ratio", "M30_Hurst", "M30_MACD", "M30_Macro1_Corr",
      "M30_Price_ZScore", "M30_OU_Theta", "M30_RSI_14", "M30_Ret_1", "M30_Vol_ZScore",
      "M5_ATR_14", "M5_Body_Ratio", "M5_Hurst", "M5_MACD", "M5_Macro1_Corr",
      "M5_Price_ZScore", "M5_OU_Theta", "M5_RSI_14", "M5_Ret_1", "M5_Vol_ZScore",
      "tick_return", "hl_ratio", "co_ratio", "avg_spread", "OIM", "tick_velocity",
      "ou_z_entry"
    ],
    "min_training_samples": 200,
    "min_positive_label_pct": 0.15
  },

  "stages": {
    "stage_1_feature_store": {
      "description": "Feature Store must contain v9_institutional_40 + v4.3_microstructure_9 records at matching timestamps for ASOF join.",
      "inputs": {},
      "outputs": {
        "v9_institutional_40": {
          "schema_name": "v9_institutional_40",
          "dimension": 40,
          "max_age_minutes": 15,
          "max_nan_pct": 0.05,
          "min_records": 100
        },
        "v4.3_microstructure_9": {
          "schema_name": "v4.3_microstructure_9",
          "dimension": 9,
          "max_age_minutes": 15,
          "max_nan_pct": 0.05,
          "min_records": 100,
          "required_fields": ["tick_return", "hl_ratio", "co_ratio", "avg_spread", "OIM", "tick_velocity"]
        }
      },
      "validation": {
        "check_schema_presence": true,
        "check_dimension_match": true,
        "check_freshness": true,
        "check_nan_rate": true,
        "check_co_timestamp_coverage": true
      }
    },

    "stage_2_journal": {
      "description": "Journal must contain accepted→closed trade pairs with PnL, labels, and p_win for MetaFilter training.",
      "inputs": {},
      "outputs": {
        "closed_trades": {
          "min_count": 200,
          "required_fields": ["position_ticket", "pnl", "label", "recorded_at", "open_message_id"],
          "valid_labels": ["win", "loss", "breakeven", "tp_hit_first", "sl_hit_first", "sl_hit_trailed"],
          "max_pnl_null_pct": 0.05
        },
        "open_entries": {
          "required_fields": ["position_ticket", "message_id", "p_win", "entry_context", "recorded_at"],
          "p_win_coverage_min": 0.30,
          "entry_context_coverage_min": 0.30
        }
      },
      "validation": {
        "check_closed_count": true,
        "check_label_coverage": true,
        "check_pnl_completeness": true,
        "check_open_close_linkage": true,
        "check_p_win_coverage": true,
        "check_entry_context_coverage": true
      }
    },

    "stage_3_dataset_builder": {
      "description": "ASOF join pairs each trade with the last feature record before entry time. Output must be 47-dim, matching model_target.feature_names_ssot in exact order.",
      "inputs": {
        "from_stage_1": ["v9_institutional_40", "v4.3_microstructure_9"],
        "from_stage_2": ["closed_trades", "open_entries"]
      },
      "outputs": {
        "dataset": {
          "format": "npz",
          "dimension": 47,
          "feature_order": "model_target.feature_names_ssot",
          "min_matched_samples": 50,
          "min_asof_join_rate": 0.80
        }
      },
      "validation": {
        "check_dimension_exact": true,
        "check_feature_order_match": true,
        "check_asof_join_rate": true,
        "check_no_future_leak": true,
        "check_label_distribution": true
      }
    },

    "stage_4_training": {
      "description": "LightGBM training with purged walk-forward CV. Output model must satisfy minimum performance gates.",
      "inputs": {
        "from_stage_3": ["dataset"]
      },
      "outputs": {
        "model": {
          "format": "lightgbm.txt",
          "input_dimension": 47,
          "min_cv_folds": 3,
          "min_post_filter_wr": 0.50,
          "max_overfitting_gap": 0.20
        }
      },
      "validation": {
        "check_dimension_consistency": true,
        "check_feature_name_isomorphism": true,
        "check_overfitting_gap": true,
        "check_min_performance": true
      }
    }
  },

  "sla": {
    "daily_readiness_check_utc": "04:00",
    "alert_on_contract_violation": true,
    "alert_channels": ["log", "dingtalk"],
    "metrics_log_path": "data_btc/reports/training_readiness.json",
    "stale_after_hours": 25
  },

  "metadata": {
    "author": "quant-os",
    "created_at": "2026-06-14",
    "rationale": "Institutional-grade data contract: every pipeline boundary has a formal input/output spec. The daily readiness checker enforces this contract at every stage. No silent drift — any violation triggers an alert immediately, not on training day.",
    "related_dqaf": ["DQAF-20260614-004"],
    "supersedes": "ad-hoc pipeline validation (pre-June 2026)"
  }
}
