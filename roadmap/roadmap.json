    "phase_b": {
      "name": "Alpha 市场期",
      "code": "alpha_market",
      "timeframe": "1.5-3年",
      "status": "planned",
      "progress_pct": 40,
      "description": "实现策略的优胜劣汰与资金动态分配，20-50个Alpha（覆盖多种模型类型）并行竞争。",
      "modules": {
        "brain_parallel": {
          "name": "Brain并行化",
          "status": "not_started",
          "description": "同时运行20-50个模型实例（覆盖 ONNX / XGBoost JSON / OU参数 / LightGBM 等多种 brain_type）",
          "depends_on": [
            "phase_a.hub_main_py",
            "phase_a.model_pipeline"
          ],
          "files": [
            "core/brains/services/brain_run_service.py",
            "core/brains/services/brain_registry_loader.py"
          ]
        },
        "alpha_market_mechanism": {
          "name": "Alpha市场机制",
          "status": "not_started",
          "description": "PortfolioAllocator 根据夏普/回撤/相关性动态分配资金",
