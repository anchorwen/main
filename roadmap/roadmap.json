          "name": "议会治理",
          "status": "in_progress",
          "progress_pct": 50,
          "description": "ParliamentService 对多个信号加权投票（统一 DecisionCandidate 接口，与模型类型无关），替代硬编码单一策略",
          "depends_on": [
            "phase_a.model_pipeline"
          ],
          "files": [
            "core/parliament/parliament_service.py",
            "core/governance/governance_rule_engine.py"
          ]
        },
        "independent_risk_agent": {
          "name": "独立风控Agent",
          "status": "not_started",
          "description": "从 RiskEvaluationService 孵化独立风控协程，主动生成对冲指令",
          "depends_on": [
            "phase_a.fix_gateway"
          ],
          "files": [
            "core/risk/risk_evaluation_service.py",
            "core/risk/risk_policies.py"
          ]
        },
        "manager_dashboard": {
          "name": "基金经理Dashboard",
          "status": "not_started",
          "description": "监控Dashboard：各Alpha资金分配、整体暴露敞口",
          "depends_on": [
            "alpha_market_mechanism",
            "parliament_governance"
          ],
          "files": [
            "core/observability/diagnostics_dashboard.py"
          ]
        }
      }
    },
    "phase_c": {
      "name": "自驱动 Quant OS",
      "code": "quant_os",
      "timeframe": "3-5年",
      "status": "planned",
      "progress_pct": 10,
      "description": "机器自我繁衍策略，多模态多智能体系统，基因池含模型类型维度，最高宪法约束一切。",
      "modules": {
        "gene_pool": {
          "name": "基因池与策略变异",
          "status": "not_started",
          "description": "基于 trainer 注册表模式，自动组合特征、修改超参、切换模型类型（ONNX / XGBoost / OU参数 / LightGBM / PyTorch JIT），生成新策略",
          "depends_on": [
            "phase_b.brain_parallel",
            "phase_a.model_pipeline"
          ],
          "files": [
            "scripts/training/your_trainer.py",
            "scripts/training/trainers/",
            "core/brains/adapters/base_adapter.py"
          ]
        },
        "sandbox_promotion": {
          "name": "沙盒晋升流水线",
          "status": "in_progress",
          "progress_pct": 30,
          "description": "新模型自动进入 ShadowLive 3个月观察，PromotionGate 自动评估晋升（与模型类型无关）",
          "depends_on": [
            "phase_a.model_pipeline"
          ],
          "files": [
            "core/alpha/promotion_gate.py",
            "scripts/live_shadow_intent_producer.py"
          ]
        },
        "dynamic_liquidity": {
          "name": "动态流动性捕获",
          "status": "not_started",
          "description": "深度学习预测微秒级订单簿失衡，滑点成本转化为套利利润",
          "depends_on": [
            "phase_b.independent_risk_agent"
          ],
          "files": [
            "core/execution/execution_manager.py",
            "core/execution/order_state_machine.py"
          ]
        },
        "k8s_cloud": {
          "name": "K8s 集群部署",
          "status": "not_started",
          "description": "算力全面云端化，Kubernetes 集群管理",
